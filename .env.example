# Copy to .env and adjust locally. Never commit .env.

# PostgreSQL
POSTGRES_DB=techearnest_crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO / S3
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=techearnest-crm
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_REGION=us-east-1

# Backend
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/techearnest_crm
DATABASE_USERNAME=crm
DATABASE_PASSWORD=crm
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# JWT — use a long random value in any shared environment; do not commit real secrets
JWT_SECRET=local-dev-only-change-me-use-32-byte-secret!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_COOKIE=te_refresh
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=15m

# Frontend (prefer relative /api/v1 so the refresh cookie stays same-site through the Vite proxy)
VITE_API_BASE_URL=/api/v1
